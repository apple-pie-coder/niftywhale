# Telegram: where entry alerts and the evening summary go. Leave blank to
# run without Telegram (alerts still appear on the dashboard).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dhan real-time data (optional; see the guide, section 4.10). Either paste a token
# in the dashboard, or fill all three for automatic daily login:
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=

# Seconds after each 15m candle closes before the watcher reads it, so the
# candle has reached yfinance.
WATCH_DELAY_SECONDS=90

# Every protocol threshold can be overridden as SMC_<NAME>. Defaults shown.
# SMC_MIN_AVG_VOLUME=1000000     # Step 2, shares/day over ~3 months
# SMC_MIN_ATR_PCT=1.5            # Step 3
# SMC_SWING_LEN=3                # bars each side of a daily swing point
# SMC_DISPLACEMENT_ATR=1.5       # Step 6, how big a rally counts as "massive"
# SMC_BOS_LOOKBACK=120           # sessions searched for the last break of structure
# SMC_MAX_DISCOUNT=0.5           # Step 8, equilibrium
# SMC_PRE_MIN_RR=1.5             # daily-stage R:R (stop under the whole leg)
# SMC_MIN_RR=3                   # Step 12, on the 15m stop
# SMC_INTRADAY_SWING_LEN=2       # bars each side of a 15m swing point

# Intraday mode (guide, section 5): any threshold or time as INTRADAY_<NAME>. Defaults shown.
# INTRADAY_MIN_AVG_VOLUME=1000000   # daily volume, shares
# INTRADAY_MIN_ATR_PCT=1.0          # daily ATR % of price
# INTRADAY_DISPLACEMENT_ATR=2.0     # 15m rally size, in 15m ATRs
# INTRADAY_MIN_TARGET_PCT=0.3       # nearest pool must be this % above entry
# INTRADAY_MIN_RR=2                 # final R:R on the 5m stop
# INTRADAY_START=09:30
# INTRADAY_NO_ENTRY_AFTER=14:30
# INTRADAY_SQUARE_OFF=15:20
